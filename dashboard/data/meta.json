acts":{"switches":23,"median_demand_after_vs_before":1.36,"customer_regions_down_over_20pct":0,"customer_region_yoy_min":0.93,"customer_region_yoy_max":1.195}},"author":"Dhruv Tibarewal","class_accuracy":[{"class":"smooth","rows":154518,"share_of_demand":0.7154,"wape_model":0.2819,"wape_best_simple":0.343,"bias_model":-0.0344},{"class":"erratic","rows":7417,"share_of_demand":0.0281,"wape_model":0.2992,"wape_best_simple":0.5379,"bias_model":-0.0578},{"class":"intermittent","rows":53638,"share_of_demand":0.248,"wape_model":0.2996,"wape_best_simple":0.3558,"bias_model":-0.0722},{"class":"lumpy","rows":2490,"share_of_demand":0.0085,"wape_model":0.4343,"wape_best_simple":0.7063,"bias_model":-0.0872}],"findings":[{"id":"growth","tag":"Demand","value":"+14%","title":"Middle East & Africa grows fastest","text":"Next 12 months vs the last 12: Middle East & Africa +14% (156k \u2192 178k units). The company as a whole +12%; slowest is Asia Pacific (+10%).","action":"Check capacity and stock for Middle East & Africa first.","link":{"view":"overview","f":{"reg":"Middle East & Africa"}}},{"id":"orion","tag":"Forecast window","value":"\u221268%","title":"Orion Driveline retools in Jul\u2013Aug 2027","text":"The events calendar lists a retooling shutdown at Orion's North American plants. The forecast drops to 985 and 1,442 units in those months, against about 3,797 in a normal month. The model learned this from the 2023 Nexon strike, not from a hand-written rule.","action":"Cut production for Orion North America in Jul\u2013Aug 2027; orders return in September.","link":{"view":"forecast","f":{"cust":"Orion Driveline","reg":"North America"}}},{"id":"hidden","tag":"Supply","value":"79k units","title":"The chip shortage hid real demand","text":"From Mar 2021 to Sep 2022, Electrical Assemblies customers asked for 235k units but only 156k shipped (\u221234%). Shipments in those months understate demand, so the forecast learns from the rebuilt numbers.","action":"Never plan from shipments in a shortage period; use the rebuilt demand.","link":{"view":"stockouts","f":{"fam":"Electrical Assemblies"}}},{"id":"lost","tag":"Supply","value":"$82M","title":"Revenue lost to stockouts","text":"The stockout file lists 82k units that were never shipped, worth about $82M at that year's list price. Semiconductor allocation caused 67% of them; logistics delay 9%.","action":"The biggest lever is semiconductor allocation: secure supply for the parts it hit most.","link":{"view":"stockouts","f":{}}},{"id":"lifecycle","tag":"Products","value":"3 replacements","title":"Three products hand over to successors","text":"PTC-005 \u2192 PTC-029 (new from 2027-03, old ends 2027-05); PMP-003 \u2192 PMP-020 (new from 2027-06, old ends 2027-08); THM-001 \u2192 THM-012 (new from 2027-10, old ends 2027-12). The old part winds down to about half once its successor launches and is 0 after its end-of-life date; the new part ramps up over about 6 months.","action":"Schedule the line changeovers and stop buying parts for the old products before end of life.","link":{"view":"lifecycle","f":{}}},{"id":"level","tag":"Accuracy","value":"7.3%","title":"Plan budgets at family level","text":"In the backtest, one part in one region for one month is off by 29% on average, but a family's monthly total only by 7.3% and the company's by 4.6%: errors in single parts cancel out.","action":"Set budgets and capacity on family totals; cover single parts with the P90 range.","link":{"view":"forecast","f":{}}},{"id":"lead","tag":"Economy","value":"2\u20133 months","title":"New vehicle orders move first","text":"Yearly changes in new vehicle orders come 2\u20133 months before the same changes in Electrical Assemblies demand (correlation 0.95), in both 2021\u201323 and 2024\u201326.","action":"Watch new vehicle orders every month as an early warning for Electrical Assemblies.","link":{"view":"drivers","f":{}}},{"id":"ev","tag":"Products","value":"9.9%","title":"The move to electric has levelled off","text":"EV-only parts went from 0% of demand in 2019 to 9.2% in 2024 and 9.9% in 2025. Petrol-only parts fell from 24% to 13%; universal parts stay about 77%.","action":"No extra EV-only capacity is needed for this forecast window; keep watching the EV index.","link":{"view":"lifecycle","f":{}}},{"id":"price","tag":"Prices","value":"No pre-buying","title":"No early buying expected before the 2027 price rise","text":"Only the 9% rise in January 2023 made customers buy early (+13% in Nov\u2013Dec 2022). The 3 rises since then (4.5%, 3.7%, 3.7%), the same size as the coming ones, showed no clear effect. Coming: 4.5% (Jan 2027) and 4.0% (Jan 2028).","action":"No extra stock is needed for early orders in Nov\u2013Dec 2026.","link":{"view":"drivers","f":{}}},{"id":"summer","tag":"Seasons","value":"\u221254%","title":"Summer shutdowns cut demand 44\u201354% every year","text":"North American demand drops a median 44% in July (retooling weeks) and European demand 54% in August (plant shutdowns), in all 8 years. The forecast keeps the dips: Europe 16k units in Aug 2027 against 30k in June.","action":"Plan lower output and deliveries for North America in July and Europe in August.","link":{"view":"explorer","f":{"reg":"Europe"}}},{"id":"gaps","tag":"Accuracy","value":"\u22127%","title":"Parts ordered with gaps run below forecast","text":"Series with gaps between orders carry 25% of demand. For them the typical-month forecast is 7% too low in the backtest (error 30% vs 36% for the best simple method), because a typical month without an order pulls the middle down.","action":"For these parts plan from the expected value or the P90, not the typical month.","link":{"view":"forecast","f":{},"state":{"esplit":"cls","emeas":"bias"}}},{"id":"accounts","tag":"Customers","value":"23 accounts","title":"Nexon Motor Group is losing accounts","text":"23 product accounts moved from one customer to another. Nexon Motor Group lost 4 and won 1; Apex Tier One won 6. No customer stopped buying altogether.","action":"Review the Nexon Motor Group relationship; the forecast follows each account's current owner.","link":{"view":"anomalies","f":{}}}],"story":[{"start":"2020-02","end":"2020-06","label":"COVID lockdowns","past":true,"scope":"Global: All","text":"Lockdowns and plant closures. Demand change: Asia Pacific -16%, Europe -45%, India -69%, Latin America -46%, North America -53%."},{"start":"2021-03","end":"2022-09","label":"Chip shortage","past":true,"scope":"Product_Family: Electrical Assemblies","text":"Global semiconductor shortage - Celeris shipments allocated below customer demand. Shipments -37%, demand +10% (Product_Family: Electrical Assemblies)."},{"start":"2022-01","end":"2022-01","label":"New region opens","past":true,"scope":"Region: Middle East & Africa","text":"Celeris opens Middle East & Africa sales region. A new region starts (series ramp up from zero) (Region: Middle East & Africa)."},{"start":"2022-11","end":"2022-12","label":"Early buying before 9% rise","past":true,"scope":"Global: All","text":"Customers order early before the ~9% price rise announced Nov 2022. Demand +13% (Global: All)."},{"start":"2023-03","end":"2023-05","label":"ERP migration","past":true,"scope":"Region: Latin America","text":"ERP migration in Latin America - some transactions were not migrated. Shipments -25%, demand -2% (Region: Latin America)."},{"start":"2023-10","end":"2023-11","label":"Nexon strike","past":true,"scope":"Customer: Nexon Motor Group | Europe","text":"Labour strike at Nexon Motor Group European assembly plants. Demand -81% (Customer: Nexon Motor Group | Europe)."},{"start":"2025-09","end":"2025-09","label":"Helios adds a line","past":true,"scope":"Customer: Helios Auto Parts | India","text":"Helios Auto Parts commissions second Indian assembly line (permanent capacity increase). Demand +23% (Customer: Helios Auto Parts | India)."},{"start":"2027-01","end":"2027-01","label":"Price rise","past":false,"scope":"Global: All","text":"Annual list-price increase of about 4.5% effective 1 January (All). In the forecast."},{"start":"2027-07","end":"2027-08","label":"Orion retooling","past":false,"scope":"Customer: Orion Driveline | North America","text":"Planned retooling shutdown at Orion Driveline North American plants (Orion Driveline | North America). In the forecast."},{"start":"2028-01","end":"2028-01","label":"Price rise","past":false,"scope":"Global: All","text":"Annual list-price increase of about 4.0% effective 1 January (All). In the forecast."}]}